/ {
	/* Toto propojí výpisy printk s USB portem */
	chosen {
		zephyr,console = &cdc_acm_uart0;
	};

	/* Definice LED na desce pro kontrolu */
	leds {
		compatible = "gpio-leds";
		blue_led: led_0 {
			gpios = <&gpioc 13 GPIO_ACTIVE_LOW>;
		};
	};

	/*
	 * Tlacitko KEY na BlackPill je na PA0 — stejny pin jako ADC1_IN0 (proud Ic).
	 * STM32F4 v analog modu vraci IDR=0 vzdy → GPIO read nefunguje.
	 * Presun sw0 na PA3 (volny pin, neni pouzit ADC, SPI, PWM).
	 * Pripoj fyzicke tlacitko: PA3 → GND (PULL_UP zajisti klidovy stav = 1).
	 */
	gpio_keys {
		compatible = "gpio-keys";
		user_button: button {
			label = "KEY";
			gpios = <&gpioa 3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			zephyr,code = <11>;
		};
	};

	aliases {
		led0 = &blue_led;
		sw0 = &user_button;
	};
};

/* Aktivace USB CDC ACM (virtuální sériový port) */
&zephyr_udc0 {
	status = "okay";
	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
	};
};

/* SPI1 pro senzor AS5048A */
&spi1 {
	status = "okay";
	pinctrl-0 = <&spi1_sck_pa5 &spi1_miso_pb4 &spi1_mosi_pb5>;
	pinctrl-names = "default";
	cs-gpios = <&gpioa 4 GPIO_ACTIVE_LOW>;

	as5048a: as5048a@0 {
		compatible = "vnd,spi-device";
		reg = <0>;
		spi-max-frequency = <1000000>;
	};
};

/* PWM pro řízení BLDC motoru přes TMC6300 */
/* TMC6300 potřebuje 6 nezávislých PWM signálů (UH, UL, VH, VL, WH, WL) */
/* TIM1 pro všechny Low side, TIM3 pro všechny High side */

/* TIM1: UL (CH1/PA8), VL (CH2/PA9), WL (CH3/PA10) */
&timers1 {
	status = "okay";
	pwm_low: pwm {
		status = "okay";
		pinctrl-0 = <&tim1_ch1_pa8 &tim1_ch2_pa9 &tim1_ch3_pa10>;
		pinctrl-names = "default";
	};
};

/* TIM3: UH (CH2/PA7), VH (CH3/PB0), WH (CH4/PB1) */
&timers3 {
	status = "okay";
	pwm_high: pwm {
		status = "okay";
		pinctrl-0 = <&tim3_ch2_pa7 &tim3_ch3_pb0 &tim3_ch4_pb1>;
		pinctrl-names = "default";
	};
};

/* ADC1: PA0 = faze W, PA1 = faze U+V */
&adc1 {
	status = "okay";
	pinctrl-0 = <&adc1_in0_pa0 &adc1_in1_pa1>;
	pinctrl-names = "default";
	#address-cells = <1>;
	#size-cells = <0>;

	channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};

	channel@1 {
		reg = <1>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};
};